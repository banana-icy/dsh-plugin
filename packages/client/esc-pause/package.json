{
  "name": "dsh-esc-pause",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：连按两次 Esc 中断当前正在生成的回合（等同输入框的停止按钮）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "escape",
    "interrupt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}